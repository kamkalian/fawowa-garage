# Vorlage für .env (nicht einchecken). Kopieren: .env.example -> .env

# Passwort des Datenbank-Benutzers "garage" (Pflicht). Zufällig und lang wählen, z. B.:  openssl rand -hex 24
# Wichtig: Wird es nach dem ersten Start geändert, bleibt in der Datenbank das alte Passwort; dann in MySQL ändern
# oder den Ordner data/mysql löschen (löscht alle Daten!).
DB_PASSWORD=

# Passwort-Hash für den Verwaltungsbereich (Pflicht dafür). Erzeugen:  node scripts/admin-passwort.js  (trägt die Zeile in .env ein)
ADMIN_PASSWORD_HASH=

# Optional: Adresse des Verwaltungsbereichs (Standard: wunderkammer). 3 bis 40 Zeichen: a-z, 0-9, Bindestrich.
# ADMIN_PATH=wunderkammer

# Testinstanz: zeigt einen Hinweis auf der Seite und bittet Suchmaschinen (X-Robots-Tag, robots.txt), sie nicht aufzunehmen.
# Für den öffentlichen Betrieb entfernen.
TESTINSTANZ=1

# Adresse der Hauptseite für den Link "Zur Hauptseite" im Kopf (auf einer nicht öffentlichen Testinstanz leer lassen)
# MAIN_SITE_URL=https://fawowa-tools.de

# Obergrenze für die Zahl der Garagen insgesamt (Standard 5000)
# MAX_GARAGEN=5000

# "Powered by" am Seitenende (optional)
# POWERED_BY=Kurm Industries
# POWERED_BY_URL=https://example.org

# --- E-Mail (freiwillig) ---
# Nutzer können eine Adresse angeben und bestätigen; über eine bestätigte Adresse bekommen sie bei Verlust einen neuen Zugangslink.
# Ohne SMTP_HOST, MAIL_FROM und PUBLIC_URL sind alle E-Mail-Funktionen abgeschaltet und in der Oberfläche ausgeblendet.
# Öffentliche Adresse der Anwendung (für die Links in den Mails, ohne Schrägstrich am Ende)
# PUBLIC_URL=https://garage.fawowa-tools.de
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# 1 für Port 465 (TLS von Anfang an); sonst wird STARTTLS genutzt, wenn der Server es anbietet
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASSWORD=
# Absender, z. B.  FaWoWa-Garage <garage@example.org>
# MAIL_FROM=
